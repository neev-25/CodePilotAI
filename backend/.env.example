# ──────────────────────────────────────────────────────────────────────────────
# CodePilot AI – Backend Environment Variables
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────────────────────────

# ── Google Gemini AI API Key (required) ───────────────────────────────────────
# Get your key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# ── Database (SQLite default, no setup required) ──────────────────────────────
DATABASE_URL=sqlite:///./codepilot.db

# ── API Protection Key (optional) ─────────────────────────────────────────────
# If set, all POST/PUT/DELETE requests must include this in the X-Api-Key header.
# Leave blank to allow unrestricted access (suitable for local development).
API_KEY=

# ── CORS Origins (comma-separated) ───────────────────────────────────────────
# Frontend URL(s) allowed to call the backend API.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Repository Storage ─────────────────────────────────────────────────────────
# Local directory where cloned repositories are stored.
REPOS_DIR=./repositories
