# CodePilotAI — Environment Variables
# Copy to .env and fill in the values.

# ── Database ────────────────────────────────────────────────────────────────
# SQLite (default for local dev):
# DATABASE_URL=sqlite:///./app/data/codepilot.db

# PostgreSQL (recommended for staging/production):
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/codepilot

DATABASE_URL=sqlite:///./app/data/codepilot.db

# ── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here

# ── Redis / Celery ───────────────────────────────────────────────────────────
# Used by the Celery worker for background indexing jobs.
# REDIS_URL=redis://localhost:6379/0

# ── Auth / Security ──────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-256-bit-secret

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
