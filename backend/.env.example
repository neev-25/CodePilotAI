# CodePilotAI — Environment Variables
# Copy to .env and fill in the values.

# ── Database ────────────────────────────────────────────────────────────────
# PostgreSQL (Industry Standard):
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/codepilot

# ── AI ───────────────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_BATCH_SIZE=5
# Keep below the actual per-minute embedding quota for the shared Gemini project.
EMBEDDING_TOKENS_PER_MINUTE=20000
EMBEDDING_MAX_RETRIES=5
EMBEDDING_INITIAL_BACKOFF=2
EMBEDDING_MAX_BACKOFF=90
EMBEDDING_BATCH_DELAY=1

# ── Redis / Celery ───────────────────────────────────────────────────────────
# Used by the Celery worker for background indexing jobs.
# REDIS_URL=redis://localhost:6379/0

# ── Auth / Security ──────────────────────────────────────────────────────────
SECRET_KEY=change-me-to-a-random-256-bit-secret

# ── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" in prod.
# When production, GEMINI_API_KEY and SECRET_KEY MUST be set or the server
# will refuse to start.
ENVIRONMENT=development

# ── Security ─────────────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-random-256-bit-secret
